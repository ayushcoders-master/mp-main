# --- Server ---
PORT=3000
NODE_ENV=development

# --- MongoDB ---
# Local MongoDB:   mongodb://127.0.0.1:27017
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=tourist_safety
# Insert demo crime / emergency / review data on the first run (set to false to start empty)
SEED_DEMO_DATA=true
# NCRB crime statistics are imported once automatically. Set to true for one start to re-import them.
REFRESH_CRIME_STATS=false

# --- Auth ---
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First admin account, created automatically if it does not exist yet (password: 8+ characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# --- Optional ---
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
NOMINATIM_URL=
NOMINATIM_USER_AGENT=
OSRM_ROUTE_URL=
